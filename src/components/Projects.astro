---
import proj1 from '../../content/projects/project-1.json';
const projects = [proj1];
---

<section id="projects" class="section">
  <div class="container">
    <h2 class="section-title">Projects</h2>
    <div class="projects-grid">
      {projects.map(proj => (
        <article class="project-card">
          <div class="project-body">
            <h3 class="project-title">{proj.title}</h3>
            <p class="project-desc">{proj.description}</p>
            <div class="tech-tags">
              {proj.technologies.map(tech => (
                <span class="tag">{tech}</span>
              ))}
            </div>
            <div class="project-links">
              <a href={proj.github} target="_blank" rel="noopener"><i class="fa-brands fa-github"></i> Code</a>
              <a href={proj.demo} target="_blank" rel="noopener"><i class="fa-solid fa-arrow-up-right-from-square"></i> Demo</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }
  .project-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.75rem;
  }
  .project-title {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }
  .project-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
  }
  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.65rem;
    background: rgba(99, 102, 241, 0.1);
    color: var(--accent-primary);
    border-radius: 50px;
  }
  .project-links {
    display: flex;
    gap: 1rem;
  }
  .project-links a {
    color: var(--text-main);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .project-links a:hover {
    color: var(--accent-primary);
  }
</style>
