---
import profileData from '../../content/profile.json';

const {
  name = "Ahmad Awadi",
  title = "Software Engineering Student & Developer",
  shortIntro = "Building clean, high-performance web applications and intuitive digital systems.",
  profileImage = "/images/profile.jpg",
  cvUrl = "/files/cv.pdf"
} = profileData || {};
---

<section id="hero" class="hero-section" aria-label="Hero Introduction">
  <div class="container hero-grid">
    <div class="hero-content">
      <div class="hero-status" role="status">
        <span class="status-dot"></span> Available for engineering roles
      </div>
      
      <h1 class="hero-name">{name}</h1>
      <p class="hero-title">{title}</p>
      <p class="hero-intro">{shortIntro}</p>
      
      <div class="hero-actions">
        {cvUrl && (
          <a href={cvUrl} class="btn btn-primary" download aria-label="Download CV">
            <i class="fa-solid fa-arrow-down-long" aria-hidden="true"></i> Resume / CV
          </a>
        )}
        <a href="#contact" class="btn btn-outline" aria-label="Contact Me">
          Get in Touch
        </a>
      </div>
    </div>

    <div class="hero-image-container">
      {profileImage ? (
        <img 
          src={profileImage} 
          alt={`Profile photo of ${name}`} 
          class="hero-avatar" 
          loading="eager"
          onerror="this.style.display='none';"
        />
      ) : (
        <div class="avatar-placeholder" aria-label="Profile Placeholder">
          <i class="fa-solid fa-user" aria-hidden="true"></i>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 80vh;
    padding-top: calc(var(--space-3xl) + 1rem);
    padding-bottom: var(--space-2xl);
    display: flex;
    align-items: center;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: 0.3rem 0.75rem;
    background: var(--bg-surface);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: 500;
    margin-bottom: var(--space-md);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background-color: #22c55e;
    border-radius: 50%;
  }

  .hero-name {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-hero);
    font-weight: 800;
    line-height: 1.1;
    color: var(--text-primary);
    letter-spacing: -1.5px;
    margin-bottom: var(--space-2xs);
  }

  .hero-title {
    font-size: var(--font-size-xl);
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: var(--space-sm);
  }

  .hero-intro {
    font-size: var(--font-size-base);
    color: var(--text-muted);
    margin-bottom: var(--space-lg);
    max-width: 540px;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: var(--font-size-sm);
    text-decoration: none;
    transition: var(--transition-fast);
  }

  .btn-primary {
    background: var(--text-primary);
    color: var(--bg-primary);
  }

  .btn-primary:hover {
    background: #e4e4e7;
  }

  .btn-outline {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
  }

  .btn-outline:hover {
    border-color: var(--border-strong);
    background: var(--bg-card-hover);
  }

  .hero-image-container {
    display: flex;
    justify-content: center;
  }

  .hero-avatar {
    width: 240px;
    height: 240px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-card);
  }

  .avatar-placeholder {
    width: 240px;
    height: 240px;
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.5rem;
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
  }

  @media (max-width: 992px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-intro {
      margin-left: auto;
      margin-right: auto;
    }
    .hero-actions {
      justify-content: center;
    }
  }
</style>
