---
import profileData from '../../content/profile.json';

const {
  name = "Student Name",
  title = "Software Engineer",
  shortIntro = "Building scalable digital solutions.",
  profileImage = "/images/profile.jpg",
  cvUrl = "/files/cv.pdf"
} = profileData || {};
---

<section id="hero" class="hero-section" aria-label="Hero Introduction">
  <div class="container hero-grid">
    <div class="hero-content">
      <div class="hero-status" role="status">
        <span class="status-dot"></span> Available for Engineering Roles
      </div>
      
      <h1 class="hero-name">{name}</h1>
      <p class="hero-title">{title}</p>
      <p class="hero-intro">{shortIntro}</p>
      
      <div class="hero-actions">
        {cvUrl && (
          <a href={cvUrl} class="btn btn-primary" download aria-label="Download CV Document">
            <i class="fa-solid fa-download" aria-hidden="true"></i> Download CV
          </a>
        )}
        <a href="#contact" class="btn btn-outline" aria-label="Navigate to Contact Section">
          <i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Contact Me
        </a>
      </div>
    </div>

    <div class="hero-image-container">
      <div class="glow-bg" aria-hidden="true"></div>
      {profileImage ? (
        <img 
          src={profileImage} 
          alt={`Profile photo of ${name}`} 
          class="hero-avatar" 
          loading="eager"
          onerror="this.style.display='none';"
        />
      ) : (
        <div class="avatar-placeholder" aria-label="Profile Avatar Placeholder">
          <i class="fa-solid fa-user" aria-hidden="true"></i>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 85vh;
    padding-top: calc(var(--space-3xl) + 2rem);
    padding-bottom: var(--space-2xl);
    display: flex;
    align-items: center;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-3xs) var(--space-xs);
    background: rgba(16, 185, 129, 0.1);
    color: var(--color-status-success);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-sm);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-status-success);
    border-radius: 50%;
  }

  .hero-name {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-hero);
    font-weight: var(--font-weight-extrabold);
    line-height: var(--line-height-tight);
    margin-bottom: var(--space-2xs);
    background: linear-gradient(180deg, #ffffff 0%, #d1d5db 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-brand-secondary);
    margin-bottom: var(--space-sm);
  }

  .hero-intro {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
    max-width: 580px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    padding: 0.8rem 1.6rem;
    border-radius: var(--radius-sm);
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-sm);
    text-decoration: none;
    transition: var(--transition-normal);
  }

  .btn-primary {
    background: var(--color-brand-gradient);
    color: #ffffff;
    box-shadow: var(--shadow-sm);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow);
  }

  .btn-outline {
    background: var(--color-bg-input);
    border: 1px solid var(--color-border);
    color: var(--color-text-main);
  }

  .btn-outline:hover {
    border-color: var(--color-border-hover);
    background: rgba(255, 255, 255, 0.08);
  }

  .hero-image-container {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .glow-bg {
    position: absolute;
    width: 260px;
    height: 260px;
    background: var(--color-brand-gradient);
    filter: blur(70px);
    opacity: 0.25;
    border-radius: 50%;
  }

  .hero-avatar {
    position: relative;
    z-index: 1;
    width: 260px;
    height: 260px;
    object-fit: cover;
    border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
    border: 2px solid var(--color-border);
    box-shadow: var(--shadow-lg);
  }

  .avatar-placeholder {
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: var(--color-bg-card);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    color: var(--color-brand-primary);
    border: 2px solid var(--color-border);
  }

  @media (max-width: 992px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-intro {
      margin-left: auto;
      margin-right: auto;
    }
    .hero-actions {
      justify-content: center;
    }
  }
</style>
