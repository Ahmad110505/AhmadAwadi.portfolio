---
const files = import.meta.glob('../../content/certifications/*.json', { eager: true });
const certs = Object.values(files).map((file: any) => file.default || file);
---

{certs.length > 0 && (
  <section id="certifications" class="section" aria-label="Certifications and Qualifications">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Verified Credentials</span>
        <h2 class="section-title">Certifications</h2>
      </div>

      <div class="certs-grid">
        {certs.map((c: any) => (
          <div class="cert-card clean-card">
            <div class="cert-icon" aria-hidden="true">
              <i class="fa-solid fa-award"></i>
            </div>
            <div class="cert-info">
              <h3 class="cert-title">{c.title}</h3>
              <p class="cert-issuer">{c.issuer} • <span>{c.date}</span></p>
              {c.credentialUrl && (
                <a 
                  href={c.credentialUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="cert-link" 
                  aria-label={`View credential for ${c.title}`}
                >
                  Verify Credential <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .certs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-md);
  }

  .cert-card {
    padding: var(--space-md);
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .cert-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-xs);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .cert-title {
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--text-primary);
  }

  .cert-issuer {
    font-size: var(--font-size-xs);
    color: var(--text-muted);
  }

  .cert-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--font-size-xs);
    color: var(--text-primary);
    text-decoration: none;
    margin-top: var(--space-3xs);
    font-weight: 500;
  }

  .cert-link:hover {
    text-decoration: underline;
  }
</style>
