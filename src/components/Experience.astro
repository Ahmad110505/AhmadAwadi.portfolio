---
const files = import.meta.glob('../../content/experience/*.json', { eager: true });
const items = Object.values(files).map((file: any) => file.default || file);
---

{items.length > 0 && (
  <section id="experience" class="section" aria-label="Work Experience Timeline">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Career Progression</span>
        <h2 class="section-title">Work Experience</h2>
      </div>

      <div class="timeline">
        {items.map((item: any) => (
          <div class="timeline-item">
            <div class="timeline-marker" aria-hidden="true"></div>
            <div class="timeline-content">
              <div class="exp-header">
                <div>
                  <h3 class="exp-position">{item.position}</h3>
                  <h4 class="exp-company"><i class="fa-solid fa-briefcase" aria-hidden="true"></i> {item.company}</h4>
                </div>
                <span class="exp-dates"><i class="fa-regular fa-calendar" aria-hidden="true"></i> {item.dates}</span>
              </div>
              <p class="exp-desc">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .timeline {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 0;
    left: 20px;
    height: 100%;
    width: 2px;
    background: var(--color-border);
  }

  .timeline-item {
    position: relative;
    padding-left: 55px;
    margin-bottom: var(--space-xl);
  }

  .timeline-marker {
    position: absolute;
    left: 11px;
    top: 6px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-bg-base);
    border: 3px solid var(--color-brand-primary);
    box-shadow: 0 0 12px var(--color-brand-primary);
  }

  .timeline-content {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    transition: var(--transition-normal);
  }

  .timeline-content:hover {
    border-color: var(--color-border-hover);
  }

  .exp-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-bottom: var(--space-xs);
  }

  .exp-position {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-main);
  }

  .exp-company {
    font-size: var(--font-size-sm);
    color: var(--color-brand-primary);
    font-weight: var(--font-weight-medium);
  }

  .exp-dates {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
  }

  .exp-desc {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  @media (max-width: 768px) {
    .timeline::before { left: 10px; }
    .timeline-item { padding-left: 35px; }
    .timeline-marker { left: 1px; }
  }
</style>
