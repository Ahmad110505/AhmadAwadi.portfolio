---
const files = import.meta.glob('../../content/experience/*.json', { eager: true });
const items = Object.values(files).map((file: any) => file.default || file);
---

<section id="experience" class="section">
  <div class="container">
    <h2 class="section-title">Work Experience</h2>
    <div class="exp-timeline">
      {items.length > 0 ? (
        items.map((item: any) => (
          <div class="exp-card">
            <div class="exp-header">
              <div>
                <h3 class="exp-position">{item.position}</h3>
                <h4 class="exp-company">{item.company}</h4>
              </div>
              <span class="exp-dates">{item.dates}</span>
            </div>
            <p class="exp-desc">{item.description}</p>
          </div>
        ))
      ) : (
        <p class="empty-msg">No work experience added yet.</p>
      )}
    </div>
  </div>
</section>

<style>
  .exp-timeline {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 800px;
    margin: 0 auto;
  }
  .exp-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 1.75rem;
    border-radius: var(--radius-md);
    transition: transform 0.2s, border-color 0.2s;
  }
  .exp-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent-primary);
  }
  .exp-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }
  .exp-position {
    font-size: 1.15rem;
  }
  .exp-company {
    font-size: 0.9rem;
    color: var(--accent-primary);
  }
  .exp-dates {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .exp-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .empty-msg {
    text-align: center;
    color: var(--text-muted);
  }
</style>
