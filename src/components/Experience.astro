---
const files = import.meta.glob('../../content/experience/*.json', { eager: true });
const items = Object.values(files).map((file: any) => file.default || file);
---

{items.length > 0 && (
  <section id="experience" class="section" aria-label="Work Experience Timeline">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Career Progression</span>
        <h2 class="section-title">Experience</h2>
      </div>

      <div class="timeline">
        {items.map((item: any) => (
          <div class="timeline-item">
            <div class="timeline-marker" aria-hidden="true"></div>
            <div class="timeline-content clean-card">
              <div class="exp-header">
                <div>
                  <h3 class="exp-position">{item.position}</h3>
                  <h4 class="exp-company">{item.company}</h4>
                </div>
                <span class="exp-dates">{item.dates}</span>
              </div>
              <p class="exp-desc">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .timeline {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 0;
    left: 20px;
    height: 100%;
    width: 1px;
    background: var(--border-subtle);
  }

  .timeline-item {
    position: relative;
    padding-left: 50px;
    margin-bottom: var(--space-xl);
  }

  .timeline-marker {
    position: absolute;
    left: 15px;
    top: 10px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--text-primary);
    border: 2px solid var(--bg-primary);
  }

  .timeline-content {
    padding: var(--space-md);
  }

  .exp-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-bottom: var(--space-xs);
  }

  .exp-position {
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--text-primary);
  }

  .exp-company {
    font-size: var(--font-size-sm);
    color: var(--text-secondary);
    font-weight: 500;
  }

  .exp-dates {
    font-size: var(--font-size-xs);
    color: var(--text-muted);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-xs);
  }

  .exp-desc {
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
  }

  @media (max-width: 768px) {
    .timeline::before { left: 10px; }
    .timeline-item { padding-left: 35px; }
    .timeline-marker { left: 5px; }
  }
</style>
