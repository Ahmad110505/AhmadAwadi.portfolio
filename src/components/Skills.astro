---
const files = import.meta.glob('../../content/skills/*.json', { eager: true });
const skillFiles = Object.values(files).map((file: any) => file.default || file);
const skills = skillFiles.flat();

// Group skills by category
const categories: Record<string, string[]> = {};
skills.forEach((s: any) => {
  const cat = s.category || 'General';
  if (!categories[cat]) categories[cat] = [];
  categories[cat].push(s.name);
});
const catKeys = Object.keys(categories);
---

{skills.length > 0 && (
  <section id="skills" class="section" aria-label="Technical Skills Grid">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Technical Competencies</span>
        <h2 class="section-title">Skills</h2>
      </div>

      <div class="skills-categories">
        {catKeys.map((cat) => (
          <div class="skill-category-block">
            <h3 class="category-title">{cat}</h3>
            <div class="skills-grid">
              {categories[cat].map((skillName) => (
                <div class="skill-pill">
                  <span>{skillName}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .skills-categories {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 900px;
    margin: 0 auto;
  }

  .category-title {
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: var(--space-xs);
  }

  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .skill-pill {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-xs);
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--text-primary);
    transition: var(--transition-fast);
  }

  .skill-pill:hover {
    border-color: var(--border-strong);
    background: var(--bg-card-hover);
  }
</style>
