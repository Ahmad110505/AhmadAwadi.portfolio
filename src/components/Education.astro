---
const files = import.meta.glob('../../content/education/*.json', { eager: true });
const items = Object.values(files).map((file: any) => file.default || file);
---

{items.length > 0 && (
  <section id="education" class="section" aria-label="Education History">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Academic Background</span>
        <h2 class="section-title">Education</h2>
      </div>

      <div class="edu-grid">
        {items.map((item: any) => (
          <div class="edu-card clean-card">
            <div class="edu-header">
              <span class="edu-dates"><i class="fa-regular fa-calendar" aria-hidden="true"></i> {item.dates}</span>
              <h3 class="edu-degree">{item.degree}</h3>
            </div>
            <h4 class="edu-field">{item.field}</h4>
            <p class="edu-institution">
              <i class="fa-solid fa-building-columns" aria-hidden="true"></i> {item.institution}
            </p>
            {item.description && <p class="edu-desc">{item.description}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .edu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-md);
  }

  .edu-card {
    padding: var(--space-lg);
  }

  .edu-dates {
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--text-muted);
  }

  .edu-degree {
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--text-primary);
    margin-top: var(--space-3xs);
  }

  .edu-field {
    font-size: var(--font-size-base);
    color: var(--text-secondary);
    font-weight: 500;
    margin-bottom: var(--space-xs);
  }

  .edu-institution {
    font-size: var(--font-size-sm);
    color: var(--text-dim);
  }

  .edu-desc {
    margin-top: var(--space-xs);
    font-size: var(--font-size-sm);
    color: var(--text-muted);
  }
</style>
