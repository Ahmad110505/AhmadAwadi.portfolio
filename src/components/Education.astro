---
import edu1 from '../../content/education/education-1.json';
const items = [edu1];
---

<section id="education" class="section">
  <div class="container">
    <h2 class="section-title">Education</h2>
    <div class="edu-grid">
      {items.map(item => (
        <div class="edu-card">
          <span class="edu-dates"><i class="fa-regular fa-calendar"></i> {item.dates}</span>
          <h3 class="edu-degree">{item.degree}</h3>
          <h4 class="edu-field">{item.field}</h4>
          <p class="edu-institution"><i class="fa-solid fa-building-columns"></i> {item.institution}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .edu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  .edu-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 2rem;
    border-radius: var(--radius-md);
  }
  .edu-dates {
    font-size: 0.85rem;
    color: var(--accent-primary);
    font-weight: 600;
  }
  .edu-degree {
    font-size: 1.2rem;
    margin-top: 0.5rem;
  }
  .edu-field {
    font-size: 0.95rem;
    color: var(--text-muted);
  }
  .edu-institution {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }
</style>
