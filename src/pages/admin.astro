---
import Layout from '../layouts/Layout.astro';
import profileData from '../../content/profile.json';
import skillsData from '../../content/skills/skills.json';

const projFiles = import.meta.glob('../../content/projects/*.json', { eager: true });
const projects = Object.values(projFiles).map((file: any) => file.default || file);

const eduFiles = import.meta.glob('../../content/education/*.json', { eager: true });
const education = Object.values(eduFiles).map((file: any) => file.default || file);

const expFiles = import.meta.glob('../../content/experience/*.json', { eager: true });
const experience = Object.values(expFiles).map((file: any) => file.default || file);

const certFiles = import.meta.glob('../../content/certifications/*.json', { eager: true });
const certifications = Object.values(certFiles).map((file: any) => file.default || file);
---

<Layout title="Admin Dashboard | Portfolio Content Manager">
  <div class="admin-page">
    <header class="admin-header">
      <div class="container admin-nav">
        <h1><i class="fa-solid fa-sliders"></i> Portfolio Admin Panel</h1>
        <div class="admin-actions">
          <a href="/" class="btn btn-outline"><i class="fa-solid fa-eye"></i> View Live Site</a>
          <a href="/admin/cms" class="btn btn-primary"><i class="fa-solid fa-cloud"></i> Open GitHub CMS</a>
        </div>
      </div>
    </header>

    <main class="container admin-body">
      <div class="admin-tabs">
        <button class="tab-btn active" data-tab="profile">Profile & Links</button>
        <button class="tab-btn" data-tab="projects">Projects ({projects.length})</button>
        <button class="tab-btn" data-tab="education">Education ({education.length})</button>
        <button class="tab-btn" data-tab="experience">Experience ({experience.length})</button>
        <button class="tab-btn" data-tab="skills">Skills ({skillsData.length})</button>
        <button class="tab-btn" data-tab="certifications">Certifications ({certifications.length})</button>
      </div>

      <!-- Tab 1: Profile -->
      <section id="tab-profile" class="tab-content active">
        <h2>Edit Profile & Contact Links</h2>
        <form id="profile-form" class="admin-form">
          <div class="form-row">
            <div class="form-group">
              <label>Full Name</label>
              <input type="text" id="prof-name" value={profileData.name} class="input" />
            </div>
            <div class="form-group">
              <label>Professional Title</label>
              <input type="text" id="prof-title" value={profileData.title} class="input" />
            </div>
          </div>
          <div class="form-group">
            <label>Short Introduction</label>
            <textarea id="prof-intro" rows="2" class="input">{profileData.shortIntro}</textarea>
          </div>
          <div class="form-group">
            <label>About Me Summary</label>
            <textarea id="prof-about" rows="4" class="input">{profileData.about}</textarea>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>Email Address</label>
              <input type="email" id="prof-email" value={profileData.email} class="input" />
            </div>
            <div class="form-group">
              <label>LinkedIn URL</label>
              <input type="url" id="prof-linkedin" value={profileData.linkedin} class="input" />
            </div>
            <div class="form-group">
              <label>GitHub URL</label>
              <input type="url" id="prof-github" value={profileData.github} class="input" />
            </div>
          </div>
          <button type="button" class="btn btn-primary" onclick="exportData('profile.json', getProfileJson())">
            <i class="fa-solid fa-download"></i> Export Updated profile.json
          </button>
        </form>
      </section>

      <!-- Tab 2: Projects -->
      <section id="tab-projects" class="tab-content">
        <div class="tab-header">
          <h2>Manage Projects</h2>
          <button class="btn btn-primary" onclick="showAddModal('project')"><i class="fa-solid fa-plus"></i> Add New Project</button>
        </div>
        <div class="admin-list">
          {projects.map((proj: any, idx: number) => (
            <div class="admin-card">
              <div>
                <h3>{proj.title}</h3>
                <p>{proj.description}</p>
                <div class="tags">
                  {proj.technologies?.map((t: string) => <span class="tag">{t}</span>)}
                </div>
              </div>
              <div class="card-actions">
                <button class="btn btn-danger" onclick={`deleteItem('projects', ${idx})`}><i class="fa-solid fa-trash"></i> Delete</button>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Tab 3: Education -->
      <section id="tab-education" class="tab-content">
        <div class="tab-header">
          <h2>Manage Education</h2>
          <button class="btn btn-primary" onclick="showAddModal('education')"><i class="fa-solid fa-plus"></i> Add Education</button>
        </div>
        <div class="admin-list">
          {education.map((edu: any, idx: number) => (
            <div class="admin-card">
              <div>
                <h3>{edu.degree} - {edu.field}</h3>
                <p>{edu.institution} ({edu.dates})</p>
              </div>
              <div class="card-actions">
                <button class="btn btn-danger" onclick={`deleteItem('education', ${idx})`}><i class="fa-solid fa-trash"></i> Delete</button>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Tab 4: Experience -->
      <section id="tab-experience" class="tab-content">
        <div class="tab-header">
          <h2>Manage Work Experience</h2>
          <button class="btn btn-primary" onclick="showAddModal('experience')"><i class="fa-solid fa-plus"></i> Add Experience</button>
        </div>
        <div class="admin-list">
          {experience.map((exp: any, idx: number) => (
            <div class="admin-card">
              <div>
                <h3>{exp.position} at {exp.company}</h3>
                <p>{exp.dates}</p>
                <p class="desc">{exp.description}</p>
              </div>
              <div class="card-actions">
                <button class="btn btn-danger" onclick={`deleteItem('experience', ${idx})`}><i class="fa-solid fa-trash"></i> Delete</button>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Tab 5: Skills -->
      <section id="tab-skills" class="tab-content">
        <div class="tab-header">
          <h2>Manage Skills</h2>
          <button class="btn btn-primary" onclick="showAddModal('skill')"><i class="fa-solid fa-plus"></i> Add Skill</button>
        </div>
        <div class="admin-list">
          {skillsData.map((s: any, idx: number) => (
            <div class="admin-card sm">
              <div>
                <strong>{s.name}</strong> <span class="tag">{s.category}</span>
              </div>
              <button class="btn btn-danger" onclick={`deleteItem('skills', ${idx})`}><i class="fa-solid fa-trash"></i></button>
            </div>
          ))}
        </div>
      </section>

      <!-- Tab 6: Certifications -->
      <section id="tab-certifications" class="tab-content">
        <div class="tab-header">
          <h2>Manage Certifications</h2>
          <button class="btn btn-primary" onclick="showAddModal('certification')"><i class="fa-solid fa-plus"></i> Add Certification</button>
        </div>
        <div class="admin-list">
          {certifications.map((c: any, idx: number) => (
            <div class="admin-card">
              <div>
                <h3>{c.title}</h3>
                <p>{c.issuer} • {c.date}</p>
              </div>
              <div class="card-actions">
                <button class="btn btn-danger" onclick={`deleteItem('certifications', ${idx})`}><i class="fa-solid fa-trash"></i> Delete</button>
              </div>
            </div>
          ))}
        </div>
      </section>

    </main>
  </div>

  <script is:inline>
    // Tab Navigation Logic
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById(`tab-${btn.dataset.tab}`).classList.add('active');
      });
    });

    function getProfileJson() {
      return JSON.stringify({
        name: document.getElementById('prof-name').value,
        title: document.getElementById('prof-title').value,
        shortIntro: document.getElementById('prof-intro').value,
        about: document.getElementById('prof-about').value,
        email: document.getElementById('prof-email').value,
        linkedin: document.getElementById('prof-linkedin').value,
        github: document.getElementById('prof-github').value,
      }, null, 2);
    }

    function exportData(filename, jsonStr) {
      const blob = new Blob([jsonStr], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      a.click();
      URL.revokeObjectURL(url);
    }

    function deleteItem(type, idx) {
      if (confirm(`Delete this ${type} entry?`)) {
        alert(`Entry #${idx + 1} deleted from ${type}. Save changes in your content directory or via Decap CMS.`);
      }
    }

    function showAddModal(type) {
      const title = prompt(`Enter ${type} Title / Name:`);
      if (title) {
        alert(`Added new ${type}: "${title}". You can download updated JSON or use Decap CMS to publish live.`);
      }
    }
  </script>
</Layout>

<style>
  .admin-page {
    min-height: 100vh;
    background: var(--bg-primary);
    padding-bottom: 4rem;
  }
  .admin-header {
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
    padding: 1.5rem 0;
  }
  .admin-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .admin-actions {
    display: flex;
    gap: 1rem;
  }
  .admin-body {
    margin-top: 2rem;
  }
  .admin-tabs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 2rem;
  }
  .tab-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    padding: 0.75rem 1.25rem;
    font-size: 0.95rem;
    cursor: pointer;
    font-weight: 600;
    border-bottom: 2px solid transparent;
  }
  .tab-btn.active {
    color: var(--accent-primary);
    border-bottom-color: var(--accent-primary);
  }
  .tab-content {
    display: none;
  }
  .tab-content.active {
    display: block;
  }
  .tab-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .admin-form {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 2rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .form-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .form-group label {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .input {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    color: #fff;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
  }
  .admin-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .admin-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 1.5rem;
    border-radius: var(--radius-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .admin-card.sm {
    padding: 1rem;
  }
  .tags {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }
  .tag {
    font-size: 0.75rem;
    background: rgba(99, 102, 241, 0.1);
    color: var(--accent-primary);
    padding: 0.2rem 0.5rem;
    border-radius: 50px;
  }
  .btn-danger {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.3);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .btn-danger:hover {
    background: #ef4444;
    color: #fff;
  }
</style>
