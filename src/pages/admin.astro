---
import Layout from '../layouts/Layout.astro';
import profileData from '../../content/profile.json';
import skillsData from '../../content/skills/skills.json';

const projFiles = import.meta.glob('../../content/projects/*.json', { eager: true });
const projects = Object.values(projFiles).map((file: any) => file.default || file);

const eduFiles = import.meta.glob('../../content/education/*.json', { eager: true });
const education = Object.values(eduFiles).map((file: any) => file.default || file);

const expFiles = import.meta.glob('../../content/experience/*.json', { eager: true });
const experience = Object.values(expFiles).map((file: any) => file.default || file);

const certFiles = import.meta.glob('../../content/certifications/*.json', { eager: true });
const certifications = Object.values(certFiles).map((file: any) => file.default || file);
---

<Layout title="Admin Panel — Portfolio Content Manager">
  <div class="admin-page">
    <header class="admin-header">
      <div class="container admin-nav">
        <div class="admin-brand">
          <i class="fa-solid fa-sliders brand-icon"></i>
          <div>
            <h1>Portfolio Control Center</h1>
            <p>Add, edit, and remove projects, skills, and personal information</p>
          </div>
        </div>
        <div class="admin-actions">
          <a href="/" class="btn btn-outline"><i class="fa-solid fa-arrow-left"></i> View Site</a>
          <a href="/admin/cms" class="btn btn-primary"><i class="fa-solid fa-cloud"></i> GitHub CMS</a>
        </div>
      </div>
    </header>

    <main class="container admin-body">
      <!-- Navigation Tabs -->
      <div class="admin-tabs" role="tablist">
        <button class="tab-btn active" data-tab="projects"><i class="fa-solid fa-folder-open"></i> Projects ({projects.length})</button>
        <button class="tab-btn" data-tab="profile"><i class="fa-solid fa-user-pen"></i> Profile & Links</button>
        <button class="tab-btn" data-tab="education"><i class="fa-solid fa-graduation-cap"></i> Education ({education.length})</button>
        <button class="tab-btn" data-tab="experience"><i class="fa-solid fa-briefcase"></i> Experience ({experience.length})</button>
        <button class="tab-btn" data-tab="skills"><i class="fa-solid fa-code"></i> Skills ({skillsData.length})</button>
        <button class="tab-btn" data-tab="certifications"><i class="fa-solid fa-award"></i> Certifications ({certifications.length})</button>
      </div>

      <!-- Tab 1: Manage Projects -->
      <section id="tab-projects" class="tab-content active">
        <div class="tab-header">
          <div>
            <h2>Manage Projects</h2>
            <p>Add new projects or remove existing items from your portfolio grid</p>
          </div>
          <button class="btn btn-primary" id="open-project-modal">
            <i class="fa-solid fa-plus"></i> Add New Project
          </button>
        </div>

        <div class="admin-grid" id="project-list-container">
          {projects.map((proj: any) => (
            <div class="admin-card glass-card" data-id={proj.id}>
              {proj.image && <img src={proj.image} alt={proj.title} class="card-thumb" onerror="this.style.display='none';" />}
              <div class="card-body">
                <h3>{proj.title}</h3>
                <p class="desc line-clamp-2">{proj.description}</p>
                {proj.technologies && (
                  <div class="tech-pills">
                    {proj.technologies.map((t: string) => <span class="pill">{t}</span>)}
                  </div>
                )}
                <div class="card-links">
                  {proj.github && <a href={proj.github} target="_blank"><i class="fa-brands fa-github"></i> GitHub</a>}
                  {proj.demo && <a href={proj.demo} target="_blank"><i class="fa-solid fa-arrow-up-right-from-square"></i> Demo</a>}
                </div>
              </div>
              <div class="card-actions">
                <button class="btn btn-danger btn-sm delete-proj-btn" data-id={proj.id || proj.title}>
                  <i class="fa-solid fa-trash"></i> Delete
                </button>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Tab 2: Profile & Social Links -->
      <section id="tab-profile" class="tab-content">
        <div class="tab-header">
          <div>
            <h2>Profile & Contact Settings</h2>
            <p>Update your name, title, bio, email, and social profiles</p>
          </div>
        </div>
        <form id="profile-form" class="admin-form glass-card">
          <div class="form-row">
            <div class="form-group">
              <label for="prof-name">Full Name</label>
              <input type="text" id="prof-name" value={profileData.name} class="form-input" required />
            </div>
            <div class="form-group">
              <label for="prof-title">Professional Title</label>
              <input type="text" id="prof-title" value={profileData.title} class="form-input" required />
            </div>
          </div>
          <div class="form-group">
            <label for="prof-intro">Short Introduction</label>
            <textarea id="prof-intro" rows="2" class="form-input">{profileData.shortIntro}</textarea>
          </div>
          <div class="form-group">
            <label for="prof-about">About Me Bio</label>
            <textarea id="prof-about" rows="4" class="form-input">{profileData.about}</textarea>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="prof-email">Email Address</label>
              <input type="email" id="prof-email" value={profileData.email} class="form-input" required />
            </div>
            <div class="form-group">
              <label for="prof-linkedin">LinkedIn Profile URL</label>
              <input type="url" id="prof-linkedin" value={profileData.linkedin} class="form-input" />
            </div>
            <div class="form-group">
              <label for="prof-github">GitHub Profile URL</label>
              <input type="url" id="prof-github" value={profileData.github} class="form-input" />
            </div>
          </div>
          <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk"></i> Save Profile Changes
          </button>
        </form>
      </section>

      <!-- Tab 3: Education -->
      <section id="tab-education" class="tab-content">
        <div class="tab-header">
          <h2>Education & Academic History</h2>
        </div>
        <div class="admin-list">
          {education.map((edu: any) => (
            <div class="admin-card glass-card">
              <div>
                <h3>{edu.degree} — {edu.field}</h3>
                <p>{edu.institution} ({edu.dates})</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Tab 4: Experience -->
      <section id="tab-experience" class="tab-content">
        <div class="tab-header">
          <h2>Work Experience</h2>
        </div>
        <div class="admin-list">
          {experience.map((exp: any) => (
            <div class="admin-card glass-card">
              <div>
                <h3>{exp.position} at {exp.company}</h3>
                <p class="text-muted">{exp.dates}</p>
                <p>{exp.description}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Tab 5: Skills -->
      <section id="tab-skills" class="tab-content">
        <div class="tab-header">
          <h2>Skills</h2>
        </div>
        <div class="skills-wrap">
          {skillsData.map((s: any) => (
            <div class="skill-tag-card">
              <i class="fa-solid fa-code"></i> {s.name} <span class="cat">({s.category})</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Tab 6: Certifications -->
      <section id="tab-certifications" class="tab-content">
        <div class="tab-header">
          <h2>Certifications</h2>
        </div>
        <div class="admin-list">
          {certifications.map((c: any) => (
            <div class="admin-card glass-card">
              <div>
                <h3>{c.title}</h3>
                <p>{c.issuer} • {c.date}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    </main>

    <!-- Modal Form for Adding New Project -->
    <div class="modal-overlay" id="project-modal" aria-hidden="true">
      <div class="modal-card glass-card">
        <div class="modal-header">
          <h3><i class="fa-solid fa-plus"></i> Add New Project</h3>
          <button class="close-btn" id="close-project-modal">&times;</button>
        </div>
        <form id="add-project-form" class="modal-form">
          <div class="form-group">
            <label for="proj-title">Project Title *</label>
            <input type="text" id="proj-title" placeholder="e.g. Aura AI Analytics Dashboard" required class="form-input" />
          </div>
          <div class="form-group">
            <label for="proj-desc">Description *</label>
            <textarea id="proj-desc" rows="3" placeholder="Brief explanation of what the project does..." required class="form-input"></textarea>
          </div>
          <div class="form-group">
            <label for="proj-tech">Technologies (comma separated)</label>
            <input type="text" id="proj-tech" placeholder="e.g. React, Node.js, Astro, TypeScript" class="form-input" />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="proj-image">Image URL</label>
              <input type="url" id="proj-image" placeholder="https://images.unsplash.com/..." class="form-input" />
            </div>
            <div class="form-group">
              <label for="proj-github">GitHub Repository Link</label>
              <input type="url" id="proj-github" placeholder="https://github.com/..." class="form-input" />
            </div>
          </div>
          <div class="form-group">
            <label for="proj-demo">Live Demo Link</label>
            <input type="url" id="proj-demo" placeholder="https://demo.example.com" class="form-input" />
          </div>

          <div class="modal-actions">
            <button type="button" class="btn btn-outline" id="cancel-project-modal">Cancel</button>
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check"></i> Save & Add Project</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script is:inline>
    // Tab switching
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        btn.classList.add('active');
        const target = document.getElementById(`tab-${btn.dataset.tab}`);
        if (target) target.classList.add('active');
      });
    });

    // Modal controls
    const modal = document.getElementById('project-modal');
    const openBtn = document.getElementById('open-project-modal');
    const closeBtn = document.getElementById('close-project-modal');
    const cancelBtn = document.getElementById('cancel-project-modal');

    function openModal() { modal.classList.add('active'); }
    function closeModal() { modal.classList.remove('active'); }

    if (openBtn) openBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (cancelBtn) cancelBtn.addEventListener('click', closeModal);

    // Form Submit: Add Project
    const addProjectForm = document.getElementById('add-project-form');
    if (addProjectForm) {
      addProjectForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const title = document.getElementById('proj-title').value;
        const description = document.getElementById('proj-desc').value;
        const technologies = document.getElementById('proj-tech').value.split(',').map(s => s.trim()).filter(Boolean);
        const image = document.getElementById('proj-image').value || 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=800&q=80';
        const github = document.getElementById('proj-github').value;
        const demo = document.getElementById('proj-demo').value;
        const id = `proj-${Date.now()}`;

        const newProj = { id, title, description, technologies, image, github, demo };

        // Save to LocalStorage
        const existing = JSON.parse(localStorage.getItem('custom_projects') || '[]');
        existing.push(newProj);
        localStorage.setItem('custom_projects', JSON.stringify(existing));

        // Attempt server API save
        try {
          await fetch('/api/projects', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(newProj)
          });
        } catch (err) {
          console.log('Saved to client state', err);
        }

        alert(`Project "${title}" added successfully!`);
        closeModal();
        window.location.reload();
      });
    }

    // Delete buttons
    document.querySelectorAll('.delete-proj-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        if (confirm('Are you sure you want to delete this project?')) {
          let custom = JSON.parse(localStorage.getItem('custom_projects') || '[]');
          custom = custom.filter(p => p.id !== id && p.title !== id);
          localStorage.setItem('custom_projects', JSON.stringify(custom));

          try {
            await fetch('/api/projects', {
              method: 'DELETE',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id })
            });
          } catch(err) {}

          window.location.reload();
        }
      });
    });
  </script>
</Layout>

<style>
  .admin-page {
    min-height: 100vh;
    padding-bottom: 4rem;
  }

  .admin-header {
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-subtle);
    padding: 1.75rem 0;
  }

  .admin-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .admin-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .brand-icon {
    font-size: 2rem;
    color: var(--color-accent-primary);
  }

  .admin-brand h1 {
    font-size: 1.5rem;
    font-weight: 800;
  }

  .admin-brand p {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .admin-actions {
    display: flex;
    gap: 1rem;
  }

  .admin-tabs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    border-bottom: 1px solid var(--border-subtle);
    margin: 2rem 0;
    padding-bottom: 0.5rem;
  }

  .tab-btn {
    background: none;
    border: none;
    color: var(--text-secondary);
    padding: 0.75rem 1.25rem;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: var(--transition-fast);
  }

  .tab-btn.active {
    color: var(--color-accent-primary);
    border-bottom-color: var(--color-accent-primary);
  }

  .tab-content { display: none; }
  .tab-content.active { display: block; }

  .tab-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .admin-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .admin-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .card-thumb {
    width: 100%;
    height: 150px;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .tech-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.5rem 0;
  }

  .pill {
    font-size: 0.75rem;
    background: rgba(99, 102, 241, 0.15);
    color: var(--color-accent-primary);
    padding: 0.2rem 0.6rem;
    border-radius: 50px;
  }

  .card-links {
    display: flex;
    gap: 1rem;
    font-size: 0.85rem;
  }

  .card-links a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.4rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    cursor: pointer;
    border: none;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .btn-primary {
    background: var(--color-gradient-primary);
    color: #fff;
  }

  .btn-outline {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }

  .btn-danger {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .btn-danger:hover {
    background: #ef4444;
    color: #fff;
  }

  .btn-sm {
    padding: 0.4rem 0.8rem;
    font-size: 0.8rem;
  }

  .admin-form {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .form-input {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    color: #fff;
    font-family: var(--font-family-body);
    font-size: 0.95rem;
    outline: none;
  }

  .form-input:focus {
    border-color: var(--color-accent-primary);
  }

  /* Modal Overlay */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(8px);
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: var(--transition-fast);
  }

  .modal-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .modal-card {
    width: 100%;
    max-width: 600px;
    padding: 2rem;
    position: relative;
    border-radius: var(--radius-lg);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .close-btn {
    background: none;
    border: none;
    color: var(--text-secondary);
    font-size: 1.5rem;
    cursor: pointer;
  }

  .modal-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    margin-top: 1rem;
  }

  .skills-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .skill-tag-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
  }
</style>
